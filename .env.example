# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, add the same names under Project Settings -> Environment Variables.

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the public key of a bot to show as a live demo on the marketing pages
# (Dashboard -> your bot -> "4. Add to website": the value after data-bot=)
NEXT_PUBLIC_DEMO_BOT_KEY=
